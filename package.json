{
  "name": "evaluator-IA",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js-community/odata-v2-adapter": "^1.15.12",
    "@cap-js/hana": "^2",
    "@sap-ai-sdk/orchestration": "^2.11.0",
    "@sap/cds": "^9",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4",
    "@sap/cds-dk": "^9"
  },
  "scripts": {
    "build_production": "cds build --production",
    "start": "cds-serve",
    "watch_hybrid": "cds watch --profile hybrid --livereload false"
  },
  "private": true,
  "cds": {
    "build": {
      "tasks": [
        {
          "for": "hana",
          "src": "db"
        },
        {
          "for": "nodejs"
        }
      ]
    },
    "requires": {
      "[production]": {
        "auth": "dummy"
      },
      "[hybrid]": {
        "db": "hana"
      }
    }
  }
}
